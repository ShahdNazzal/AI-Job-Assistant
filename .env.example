# ============================================================
# AI Job Assistant - environment configuration
# Copy this file to `.env` and fill in the values you need.
# The application runs fully WITHOUT any of these variables;
# they only enable the optional AI Career Assistant (LLM).
# NEVER commit your real `.env` file (it is git-ignored).
# ============================================================

# --- Optional LLM provider (OpenAI-compatible chat completions API) ---
# Any provider that exposes an OpenAI-style `/chat/completions` endpoint works,
# e.g. OpenAI, Azure OpenAI (via its own URL), Groq, Together, OpenRouter,
# Ollama (http://localhost:11434/v1), vLLM, LM Studio, etc.
LLM_API_KEY=
# Base URL WITHOUT the trailing slash and WITHOUT `/chat/completions`.
LLM_BASE_URL=https://api.openai.com/v1
# Model name as expected by your provider.
LLM_MODEL=gpt-4o-mini
# Request timeout in seconds.
LLM_TIMEOUT=30

# --- Advanced (safe to leave untouched) ---
# Sentence Transformer model used for semantic matching.
# Default: sentence-transformers/all-MiniLM-L6-v2 (~90 MB, downloaded once).
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Compatibility score weights (must sum to ~1.0 after normalization).
# WEIGHT_REQUIRED_SKILLS=0.45
# WEIGHT_PREFERRED_SKILLS=0.15
# WEIGHT_SEMANTIC_SIMILARITY=0.25
# WEIGHT_EVIDENCE=0.15
